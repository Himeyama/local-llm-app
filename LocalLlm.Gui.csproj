<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.7.0</Version>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);runtime/**;models/**;openwebui/**;publish/**;tests/**;NativeInference/**;Packaging/**</DefaultItemExcludes>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- An unavailable audit feed must not warn on every offline GUI launch.
         Keep vulnerability advisories (NU1901-NU1904) enabled. -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <Compile Remove="tests/**/*.cs" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Start-LlamaServer.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Start-RocmServer.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Cli/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Terminal/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Chat3D\index.html;Chat3D\view.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMonacoEditor" BeforeTargets="PrepareForBuild" Inputs="Editor/package.json;Editor/package-lock.json;Editor/build.mjs;Editor/editor.js;Editor/index.html" Outputs="Editor/dist/.build-stamp">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="Editor" Condition="!Exists('Editor/node_modules/esbuild/package.json')" />
    <Exec Command="npm run build" WorkingDirectory="Editor" />
  </Target>
  <Target Name="CopyMonacoRuntime" AfterTargets="Build">
    <ItemGroup><MonacoRuntime Include="Editor/dist/**/*" /></ItemGroup>
    <Copy SourceFiles="@(MonacoRuntime)" DestinationFiles="@(MonacoRuntime->'$(OutDir)Editor/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishMonacoRuntime" AfterTargets="Publish">
    <ItemGroup><MonacoPublishRuntime Include="Editor/dist/**/*" /></ItemGroup>
    <Copy SourceFiles="@(MonacoPublishRuntime)" DestinationFiles="@(MonacoPublishRuntime->'$(PublishDir)Editor/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- Node packages are runtime files, not WinUI resources. -->
  <ItemGroup>
    <BrowserSearchRuntime Include="BrowserSearch/search.mjs;BrowserSearch/package*.json;BrowserSearch/node_modules/**/*" />
  </ItemGroup>
  <Target Name="CopyBrowserSearchRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(BrowserSearchRuntime)" DestinationFiles="@(BrowserSearchRuntime->'$(OutDir)%(Identity)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBrowserSearchRuntime" AfterTargets="Publish">
    <Copy SourceFiles="@(BrowserSearchRuntime)" DestinationFiles="@(BrowserSearchRuntime->'$(PublishDir)%(Identity)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- WinUI adds these resources to build output, but does not include them
       in an unpackaged .NET publish. Keep the application PRI and XAML together. -->
  <Target Name="IncludeWinUiPublishResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The application WinUI resource index is missing from the build output." />
    <ItemGroup>
      <WinUiPublishResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(WinUiPublishResource)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
