<Window x:Class="LocalLlm.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LocalLlm.Gui.Controls">
  <Window.SystemBackdrop><MicaBackdrop Kind="Base"/></Window.SystemBackdrop>
  <Grid x:Name="RootLayout" Background="Transparent">
    <Grid.Resources>
      <ControlTemplate x:Key="VerticalResizeTemplate" TargetType="Thumb">
        <Grid Background="Transparent">
          <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"/>
          </VisualStateGroup></VisualStateManager.VisualStateGroups>
          <Border x:Name="Grip" Width="40" Height="2" CornerRadius="1" Opacity="0" Background="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
      <ControlTemplate x:Key="HorizontalResizeTemplate" TargetType="Thumb">
        <Grid Background="Transparent">
          <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"/>
          </VisualStateGroup></VisualStateManager.VisualStateGroups>
          <Border x:Name="Grip" Width="2" Height="40" CornerRadius="1" Opacity="0" Background="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
<ControlTemplate x:Key="SquircleToggleTemplate" TargetType="ToggleButton">
<Grid x:Name="StateRoot" Background="Transparent">
<VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundPointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundPointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundPressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundDisabled}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundDisabled}"/></VisualState.Setters></VisualState><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundChecked}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundChecked}"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundCheckedPointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundCheckedPointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundCheckedPressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundCheckedPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Indeterminate"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundIndeterminate}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundIndeterminate}"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminatePointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundIndeterminatePointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundIndeterminatePointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminatePressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundIndeterminatePressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundIndeterminatePressed}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
<local:SquircleSurface x:Name="Surface" Fill="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
<ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid>
</ControlTemplate>
<ControlTemplate x:Key="SquircleButtonTemplate" TargetType="Button">
<Grid x:Name="StateRoot" Background="Transparent">
<VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ButtonBackgroundPointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ButtonBackgroundPressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ButtonBackgroundDisabled}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
<local:SquircleSurface x:Name="Surface" Fill="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
<ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid>
</ControlTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="Local LLM" Subtitle="ローカル AI ワークスペース"
              IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource><SymbolIconSource Symbol="Message"/></TitleBar.IconSource>
    </TitleBar>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="MenuRail" Spacing="12" Padding="8,20,8,8">
        <StackPanel.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#18000000"/>
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#22000000"/>
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2C000000"/>
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush"/>
          <Style TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource SquircleToggleTemplate}"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
        </StackPanel.Resources>
        <ToggleButton Tag="chat" Click="OnMenuClick" ToolTipService.ToolTip="チャット" AutomationProperties.Name="チャット">
          <ToggleButton.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="脆弱性診断モード（プロトタイプ）" Click="OnOpenInvestigation"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Permissions"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></ToggleButton.ContextFlyout>
          <SymbolIcon Symbol="Message"/>
        </ToggleButton>
        <ToggleButton Tag="server" Click="OnMenuClick" ToolTipService.ToolTip="llama-server" AutomationProperties.Name="llama-server"><SymbolIcon Symbol="Setting"/></ToggleButton>
        <ToggleButton Tag="cli" Click="OnMenuClick" ToolTipService.ToolTip="Claude / Codex" AutomationProperties.Name="Claude / Codex"><FontIcon Glyph="&#xE756;"/></ToggleButton>
        <ToggleButton Tag="logs" Click="OnMenuClick" ToolTipService.ToolTip="ログ" AutomationProperties.Name="ログ"><SymbolIcon Symbol="Document"/></ToggleButton>
      </StackPanel>
      <Grid x:Name="HistoryPane" Grid.Column="1" Width="240" Padding="12,20,12,12" SizeChanged="OnHistoryLayoutChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ChatHistoryRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:WorkspaceExplorerView x:Name="ExplorerPane" Height="240" Visibility="Collapsed"/>
        <local:VerticalResizeHandle x:Name="ExplorerResizeHandle" Grid.Row="1" Height="8" Visibility="Collapsed" HandleTemplate="{StaticResource VerticalResizeTemplate}" DragStarted="OnExplorerResizeStarted" DragDelta="OnExplorerResizeDelta" KeyDown="OnExplorerResizeKeyDown" AutomationProperties.Name="エクスプローラーとチャット履歴の高さを調整" ToolTipService.ToolTip="ドラッグして高さを調整"/>
        <Grid x:Name="ChatHistoryPanel" Grid.Row="2" MinHeight="144" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button x:Name="ChatSectionToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32" Click="OnToggleChatSection" AutomationProperties.Name="チャットを折りたたむ">
          <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon x:Name="ChatSectionChevron" Glyph="&#xE70D;" FontSize="10"/><TextBlock Text="チャット" FontSize="14" FontWeight="SemiBold"/></StackPanel>
        </Button>
        <Button x:Name="NewChatButton" Grid.Row="1" HorizontalAlignment="Stretch" Click="OnNewChat" AutomationProperties.Name="新しいチャット"><StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Add"/><TextBlock Text="新しいチャット"/></StackPanel></Button>
        <ListView x:Name="SessionList" Grid.Row="2" SelectionChanged="OnSessionSelected" SelectionMode="Single" ContextRequested="OnSessionContextRequested" PreviewKeyDown="OnHistoryPreviewKeyDown">
          <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,6"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        </Grid>
        <local:VerticalResizeHandle x:Name="GitResizeHandle" Grid.Row="3" Height="8" Visibility="Collapsed" HandleTemplate="{StaticResource VerticalResizeTemplate}" DragStarted="OnGitResizeStarted" DragDelta="OnGitResizeDelta" KeyDown="OnGitResizeKeyDown" AutomationProperties.Name="チャット履歴と Git の高さを調整" ToolTipService.ToolTip="ドラッグして高さを調整"/>
        <Grid x:Name="GitPanel" Grid.Row="4" Height="320" Visibility="Collapsed" SizeChanged="OnHistoryLayoutChanged"/>
      </Grid>
      <Grid x:Name="PageLayout" Grid.Column="2" Padding="24,20,24,20" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Text="llama-server" FontSize="28" FontWeight="SemiBold"/>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
        <Grid Grid.Row="2" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <CommandBar x:Name="ServerCommandBar" Visibility="Collapsed" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
            <AppBarButton x:Name="ServerStartButton" Label="llama-server を起動" Icon="Play" Click="OnToggleServer"/>
            <AppBarButton x:Name="ServerSaveButton" Label="設定を保存" Icon="Save" Click="OnSaveServerSettings"/>
          </CommandBar>
          <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="OnFormSizeChanged">
            <StackPanel x:Name="Form" Spacing="16" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          </ScrollViewer>
          <ScrollViewer x:Name="LogScroll" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <TextBlock x:Name="LogView" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Cascadia Code, Noto Sans JP" Padding="12" AutomationProperties.Name="ログ"/>
          </ScrollViewer>
          <Grid x:Name="InvestigationPanel" Grid.RowSpan="2" Visibility="Collapsed" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="InvestigationHistory" PlaceholderText="保存した調査" HorizontalAlignment="Stretch" SelectionChanged="OnInvestigationSelected" AutomationProperties.Name="診断履歴"/>
              <Button x:Name="NewInvestigationButton" Grid.Column="1" Content="新しい調査" Click="OnNewInvestigation"/>
            </Grid>
            <Expander x:Name="InvestigationSettings" Grid.Row="1" Header="対象範囲と実行条件" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <TextBlock Text="HTTP プロトタイプ · 匿名 GET / HEAD · ワーカー2並列 · 自動リダイレクトなし。ブラウザー・シェル・認証操作は未対応です。GETでも状態が変わるURLは除外してください。" TextWrapping="Wrap" Opacity="0.7"/>
                  <TextBox x:Name="InvestigationTarget" Header="対象URL（同一オリジン・このパス配下のみ）" PlaceholderText="https://your-site.example/app/"/>
                  <TextBox x:Name="InvestigationExcluded" Header="除外パス（1行に1件）" PlaceholderText="/app/logout&#xA;/app/delete" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"/>
                  <TextBox x:Name="InvestigationRestrictions" Header="追加の許可・禁止事項（プランナーへの指示）" PlaceholderText="例：公開ページと公開APIのみ。フォーム送信・ログイン・購入は禁止。" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"/>
                  <TextBlock Text="実行側で強制する制約：URL範囲・除外パス・GET/HEAD・通信数。自由記述の制約はAIへの指示です。通信本文を含む証拠はローカルに保存されます。" TextWrapping="Wrap" Opacity="0.7"/>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <NumberBox x:Name="InvestigationRequestLimit" Header="通信上限" Minimum="1" Maximum="100" Value="24" Width="120" SpinButtonPlacementMode="Compact"/>
                    <NumberBox x:Name="InvestigationRoundLimit" Header="計画回数" Minimum="1" Maximum="10" Value="4" Width="120" SpinButtonPlacementMode="Compact"/>
                  </StackPanel>
                  <CheckBox x:Name="InvestigationAuthorized" Content="自分が管理する、または診断の許可を得た対象です"/>
                </StackPanel>
              </ScrollViewer>
            </Expander>
            <Pivot Grid.Row="2">
              <PivotItem Header="調査チャット"><ScrollViewer x:Name="InvestigationScroll" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14" Padding="0,8,12,12"><StackPanel x:Name="InvestigationMessages" Spacing="14"/><TextBlock x:Name="InvestigationLiveReasoning" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" Opacity="0.6"/></StackPanel></ScrollViewer></PivotItem>
              <PivotItem Header="検出・再テスト"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InvestigationFindings" Spacing="12"/></ScrollViewer></PivotItem>
              <PivotItem Header="通信証拠"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InvestigationEvidence" Spacing="8"/></ScrollViewer></PivotItem>
              <PivotItem Header="資産・探索グラフ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InvestigationGraph" Spacing="10"/></ScrollViewer></PivotItem>
            </Pivot>
            <StackPanel Grid.Row="3" Spacing="8">
              <TextBlock x:Name="InvestigationStatus" Text="調査目的を入力して開始してください。" TextWrapping="Wrap" Opacity="0.7"/>
              <Border x:Name="InvestigationComposer" BorderBrush="{ThemeResource TextControlBorderBrush}" Background="{ThemeResource TextControlBackground}" BorderThickness="1" CornerRadius="12">
                <Grid>
                  <TextBox x:Name="InvestigationInput" PlaceholderText="調査目的・追加の指示（Ctrl+Enterで開始）" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" CornerRadius="12" Padding="12,12,12,56" MinHeight="120" MaxHeight="240" PreviewKeyDown="OnInvestigationKeyDown" GotFocus="OnInvestigationInputGotFocus" LostFocus="OnInvestigationInputLostFocus">
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Spacing="4">
                    <ToggleButton x:Name="InvestigationReasoningVisibilityButton" Template="{StaticResource SquircleToggleTemplate}" CornerRadius="8" UseSystemFocusVisuals="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnToggleInvestigationReasoningVisibility" IsChecked="False" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="推論内容を表示する" AutomationProperties.Name="推論内容を表示する"><FontIcon Glyph="&#xE890;"/></ToggleButton>
                    <Button x:Name="StartInvestigationButton" Click="OnStartInvestigation" Style="{StaticResource AccentButtonStyle}" Width="40" Height="40" Padding="0" CornerRadius="20" BorderThickness="0" ToolTipService.ToolTip="調査を開始・続行" AutomationProperties.Name="調査を開始・続行"><SymbolIcon Symbol="Send"/></Button>
                    <Button x:Name="StopInvestigationButton" Click="OnStopInvestigation" Width="40" Height="40" Padding="0" CornerRadius="20" Visibility="Collapsed" IsEnabled="False" ToolTipService.ToolTip="診断を停止" AutomationProperties.Name="診断を停止"><SymbolIcon Symbol="Stop"/></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
          <Grid x:Name="ChatWorkspaceLayout" Grid.RowSpan="2" SizeChanged="OnChatWorkspaceSizeChanged">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="ChatPanel">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="0"/><ColumnDefinition x:Name="EditorDividerColumn" Width="0"/><ColumnDefinition x:Name="ConversationColumn" Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="EditorPane" Visibility="Collapsed" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource TextControlBackground}" CornerRadius="8">
              <local:FileEditorView x:Name="FileEditor"/>
            </Border>
            <local:HorizontalResizeHandle x:Name="EditorResizeHandle" Grid.Column="1" Visibility="Collapsed" HandleTemplate="{StaticResource HorizontalResizeTemplate}" DragStarted="OnEditorResizeStarted" DragDelta="OnEditorResizeDelta" KeyDown="OnEditorResizeKeyDown" AutomationProperties.Name="エディタとチャットの幅を調整" ToolTipService.ToolTip="ドラッグして左右の幅を調整"/>
            <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnChatSizeChanged" ViewChanged="OnChatViewChanged"><StackPanel x:Name="ChatMessages" Spacing="18" Padding="0,12,12,16"/></ScrollViewer>
            <Grid x:Name="ChatActivityPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0.6" ColumnSpacing="6" SizeChanged="OnConsoleLayoutChanged">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ChatActivitySpinner" FontFamily="Segoe UI Symbol" MinWidth="16"/>
              <TextBlock x:Name="ChatActivity" Grid.Column="1" TextWrapping="Wrap"/>
            </Grid>
            <ScrollViewer x:Name="PendingChatScroll" Grid.Row="2" MaxHeight="96" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnConsoleLayoutChanged">
              <StackPanel x:Name="PendingChatMessages" Spacing="4" Opacity="0.65"/>
            </ScrollViewer>
            <Border x:Name="ChatComposer" Grid.Row="3" Margin="0,8,0,0" SizeChanged="OnConsoleLayoutChanged" Background="{ThemeResource TextControlBackground}" BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1" CornerRadius="12">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="AttachmentList" Spacing="6" Margin="12,8,12,0" Visibility="Collapsed"/>
                <Grid Grid.Row="1">
                  <TextBox x:Name="ChatInput" PlaceholderText="メッセージを入力（Enter で送信、Shift+Enter で改行）" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="12,12,12,52" MinHeight="120" MaxHeight="240" PreviewKeyDown="OnChatKeyDown" TextChanged="OnChatInputTextChanged" GotFocus="OnChatInputGotFocus" LostFocus="OnChatInputLostFocus">
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Spacing="4">
                    <StackPanel.Resources><Style TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></StackPanel.Resources>
                    <Button x:Name="AttachButton" Click="OnAttachImage" ToolTipService.ToolTip="画像を追加" AutomationProperties.Name="画像を追加"><SymbolIcon Symbol="Attach"/></Button>
                    <Button x:Name="ChatWorkspaceButton" Click="OnChatWorkspaceSettings" ToolTipService.ToolTip="作業フォルダー設定" AutomationProperties.Name="作業フォルダー設定"><SymbolIcon Symbol="Folder"/></Button>
                    <Button x:Name="ChatToolsButton" Click="OnChatToolsSettings" ToolTipService.ToolTip="ツール設定" AutomationProperties.Name="ツール設定"><SymbolIcon Symbol="Repair"/></Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Spacing="4">
                    <ToggleButton x:Name="ChatReasoningVisibilityButton" Template="{StaticResource SquircleToggleTemplate}" CornerRadius="8" UseSystemFocusVisuals="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnToggleChatReasoningVisibility" Width="40" Height="40" Padding="0" BorderThickness="0" ToolTipService.ToolTip="推論内容の表示" AutomationProperties.Name="推論内容の表示"><FontIcon Glyph="&#xE890;"/></ToggleButton>
                    <Button x:Name="ChatReasoningButton" Template="{StaticResource SquircleButtonTemplate}" CornerRadius="8" UseSystemFocusVisuals="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnChatReasoningSettings" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="推論レベル" AutomationProperties.Name="推論レベル"><FontIcon Glyph="&#xE82F;"/></Button>
                    <Button x:Name="ChatConsoleButton" Template="{StaticResource SquircleButtonTemplate}" CornerRadius="8" UseSystemFocusVisuals="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnToggleConsole" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="PowerShell コンソール" AutomationProperties.Name="PowerShell コンソール"><FontIcon Glyph="&#xE756;"/></Button>
                    <Button x:Name="SendChatButton" Click="OnSendChat" Style="{StaticResource AccentButtonStyle}" Width="40" Height="40" Padding="0" CornerRadius="20" BorderThickness="0" ToolTipService.ToolTip="送信" AutomationProperties.Name="送信"><SymbolIcon Symbol="Send"/></Button>
                    <Button x:Name="StopChatButton" Click="OnStopChat" Width="40" Height="40" Padding="0" CornerRadius="20" Visibility="Collapsed" ToolTipService.ToolTip="停止" AutomationProperties.Name="停止"><SymbolIcon Symbol="Stop"/></Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
            </Grid>
          </Grid>
          <Grid x:Name="ConsolePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <local:VerticalResizeHandle HandleTemplate="{StaticResource VerticalResizeTemplate}" DragStarted="OnConsoleResizeStarted" DragDelta="OnConsoleResizeDelta" KeyDown="OnConsoleResizeKeyDown" AutomationProperties.Name="ターミナルの高さを調整" ToolTipService.ToolTip="ドラッグしてターミナルの高さを調整"/>
            <Border Grid.Row="1" Background="{ThemeResource TextControlBackground}" BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1" CornerRadius="8"><Grid x:Name="ConsoleHost" Height="280"/></Border>
          </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="GitStatus" Grid.Column="1" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
          <Button x:Name="GitBranchButton" Click="OnGitBranchClick" Background="Transparent" BorderThickness="0" Padding="0,0,6,0" MinWidth="0" MinHeight="0" FontSize="12" MaxWidth="220" AutomationProperties.Name="Git ブランチを切り替え・作成"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE895;" FontSize="12"/><TextBlock x:Name="GitBranchText" TextTrimming="CharacterEllipsis" MaxWidth="180"/></StackPanel></Button>
          <Button x:Name="GitStatusPullButton" Click="OnGitPull" Background="Transparent" BorderThickness="0" Padding="4,0" MinHeight="0" MinWidth="0" FontSize="12" Visibility="Collapsed" AutomationProperties.Name="Git プル"/>
          <Button x:Name="GitStatusPushButton" Click="OnGitPush" Background="Transparent" BorderThickness="0" Padding="4,0" MinHeight="0" MinWidth="0" FontSize="12" Visibility="Collapsed" AutomationProperties.Name="Git プッシュ"/>
        </StackPanel>
        <Grid Grid.Column="0">
          <Button x:Name="LlamaStatusButton" Click="OnToggleServer" Padding="0" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
              <Run x:Name="LlamaStatusPrefix" Text="llama-server: "/><Run x:Name="LlamaStatusState"/><Run x:Name="LlamaStatusDetail" Text="確認中"/>
            </TextBlock>
          </Button>
        </Grid>
        <TextBlock x:Name="GitOperationStatusText" Grid.Column="2" Visibility="Collapsed" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel x:Name="EditorStatus" Grid.Column="3" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
          <Button x:Name="EditorEncodingButton" Content="UTF-8" Click="OnEditorEncodingClick" Background="Transparent" BorderThickness="0" Padding="6,0" MinHeight="0" MinWidth="0" FontSize="12" ToolTipService.ToolTip="文字コードを変更" AutomationProperties.Name="文字コードを変更"/>
          <Button x:Name="EditorLineEndingButton" Content="LF" Click="OnEditorLineEndingClick" Background="Transparent" BorderThickness="0" Padding="6,0" MinHeight="0" MinWidth="0" FontSize="12" ToolTipService.ToolTip="改行コードを変更" AutomationProperties.Name="改行コードを変更"/>
        </StackPanel>
        <TextBlock x:Name="ChatStatusText" Grid.Column="4" Visibility="Collapsed" TextWrapping="NoWrap" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="直近の推論の入力と生成の合計トークン数 / サーバーの最大コンテキスト数。使用数は応答取得後に更新します。"/>
      </Grid>
    </Border>
  </Grid>
</Window>
