<Window x:Class="LocalLlm.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LocalLlm.Gui.Controls">
  <Window.SystemBackdrop><MicaBackdrop Kind="Base"/></Window.SystemBackdrop>
  <Grid x:Name="RootLayout" Background="Transparent">
    <Grid.Resources>
<ControlTemplate x:Key="SquircleToggleTemplate" TargetType="ToggleButton">
<Grid x:Name="StateRoot" Background="Transparent">
<VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundPointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundPointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundPressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundDisabled}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundDisabled}"/></VisualState.Setters></VisualState><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundChecked}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundChecked}"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundCheckedPointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundCheckedPointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundCheckedPressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundCheckedPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Indeterminate"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundIndeterminate}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundIndeterminate}"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminatePointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundIndeterminatePointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundIndeterminatePointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminatePressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ToggleButtonBackgroundIndeterminatePressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ToggleButtonForegroundIndeterminatePressed}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
<local:SquircleSurface x:Name="Surface" Fill="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
<ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid>
</ControlTemplate>
<ControlTemplate x:Key="SquircleButtonTemplate" TargetType="Button">
<Grid x:Name="StateRoot" Background="Transparent">
<VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ButtonBackgroundPointerOver}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ButtonBackgroundPressed}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Surface.Fill" Value="{ThemeResource ButtonBackgroundDisabled}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
<local:SquircleSurface x:Name="Surface" Fill="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
<ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid>
</ControlTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="Local LLM" Subtitle="ローカル AI ワークスペース"
              IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource><SymbolIconSource Symbol="Message"/></TitleBar.IconSource>
    </TitleBar>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="MenuRail" Spacing="12" Padding="8,20,8,8">
        <StackPanel.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#18000000"/>
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#22000000"/>
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2C000000"/>
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush"/>
          <Style TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource SquircleToggleTemplate}"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
        </StackPanel.Resources>
        <ToggleButton Tag="chat" Click="OnMenuClick" ToolTipService.ToolTip="チャット" AutomationProperties.Name="チャット"><SymbolIcon Symbol="Message"/></ToggleButton>
        <ToggleButton Tag="server" Click="OnMenuClick" ToolTipService.ToolTip="llama-server" AutomationProperties.Name="llama-server"><SymbolIcon Symbol="Setting"/></ToggleButton>
        <ToggleButton Tag="web" Click="OnMenuClick" ToolTipService.ToolTip="Open WebUI" AutomationProperties.Name="Open WebUI"><SymbolIcon Symbol="Globe"/></ToggleButton>
        <ToggleButton Tag="cli" Click="OnMenuClick" ToolTipService.ToolTip="Claude / Codex" AutomationProperties.Name="Claude / Codex"><FontIcon Glyph="&#xE756;"/></ToggleButton>
        <ToggleButton Tag="logs" Click="OnMenuClick" ToolTipService.ToolTip="ログ" AutomationProperties.Name="ログ"><SymbolIcon Symbol="Document"/></ToggleButton>
      </StackPanel>
      <Grid x:Name="HistoryPane" Grid.Column="1" Width="240" Padding="12,20,12,12" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="チャット" FontSize="20" FontWeight="SemiBold"/>
        <Button x:Name="NewChatButton" Grid.Row="1" HorizontalAlignment="Stretch" Click="OnNewChat" AutomationProperties.Name="新しいチャット"><StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Add"/><TextBlock Text="新しいチャット"/></StackPanel></Button>
        <ListView x:Name="SessionList" Grid.Row="2" SelectionChanged="OnSessionSelected" SelectionMode="Single" ContextRequested="OnSessionContextRequested" PreviewKeyDown="OnHistoryPreviewKeyDown">
          <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,6"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
      </Grid>
      <Grid Grid.Column="2" Padding="24,20,24,20" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Text="llama-server" FontSize="28" FontWeight="SemiBold"/>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
        <Grid Grid.Row="2" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <CommandBar x:Name="ServerCommandBar" Visibility="Collapsed" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
            <AppBarButton x:Name="ServerStartButton" Label="llama-server を起動" Icon="Play" Click="OnToggleServer"/>
            <AppBarButton x:Name="ServerSaveButton" Label="設定を保存" Icon="Save" Click="OnSaveServerSettings"/>
          </CommandBar>
          <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="OnFormSizeChanged">
            <StackPanel x:Name="Form" Spacing="16" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          </ScrollViewer>
          <Grid x:Name="WebPanel" Grid.RowSpan="2" Visibility="Collapsed" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
              <AppBarButton x:Name="StartWebButton" IsEnabled="False" Label="Open WebUI を起動" Icon="Play" Click="OnStartWeb"/>
              <AppBarButton x:Name="StopWebButton" IsEnabled="False" Label="停止" Icon="Stop" Click="OnStopWeb"/>
              <AppBarButton x:Name="ReloadWebButton" IsEnabled="False" Label="再読み込み" Icon="Refresh" Click="OnReloadWeb"/>
              <AppBarButton x:Name="ExternalWebButton" IsEnabled="False" Label="外部ブラウザー" Icon="Globe" Click="OnExternalWeb"/>
            </CommandBar>
            <WebView2 x:Name="Browser" Grid.Row="1" Visibility="Collapsed"/>
          </Grid>
          <TextBox x:Name="LogView" Grid.RowSpan="2" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Code, Noto Sans JP" Background="Transparent"/>
          <Grid x:Name="ChatPanel" Grid.RowSpan="2" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnChatSizeChanged" ViewChanged="OnChatViewChanged"><StackPanel x:Name="ChatMessages" Spacing="18" Padding="0,12,12,16"/></ScrollViewer>
            <Grid x:Name="ChatActivityPanel" Grid.Row="1" Visibility="Collapsed" Opacity="0.6" ColumnSpacing="6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ChatActivitySpinner" FontFamily="Segoe UI Symbol" MinWidth="16"/>
              <TextBlock x:Name="ChatActivity" Grid.Column="1" TextWrapping="Wrap"/>
            </Grid>
            <ScrollViewer x:Name="PendingChatScroll" Grid.Row="2" MaxHeight="96" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="PendingChatMessages" Spacing="4" Opacity="0.65"/>
            </ScrollViewer>
            <Border x:Name="ChatComposer" Grid.Row="3" Background="{ThemeResource TextControlBackground}" BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1" CornerRadius="12">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="AttachmentList" Spacing="6" Margin="12,8,12,0" Visibility="Collapsed"/>
                <Grid Grid.Row="1">
                  <TextBox x:Name="ChatInput" PlaceholderText="メッセージを入力（Enter で送信、Shift+Enter で改行）" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="12,12,12,52" MinHeight="120" MaxHeight="240" PreviewKeyDown="OnChatKeyDown" TextChanged="OnChatInputTextChanged" GotFocus="OnChatInputGotFocus" LostFocus="OnChatInputLostFocus">
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Spacing="4">
                    <StackPanel.Resources><Style TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></StackPanel.Resources>
                    <Button x:Name="AttachButton" Click="OnAttachImage" ToolTipService.ToolTip="画像を追加" AutomationProperties.Name="画像を追加"><SymbolIcon Symbol="Attach"/></Button>
                    <Button x:Name="ChatWorkspaceButton" Click="OnChatWorkspaceSettings" ToolTipService.ToolTip="作業フォルダー設定" AutomationProperties.Name="作業フォルダー設定"><SymbolIcon Symbol="Folder"/></Button>
                    <Button x:Name="ChatToolsButton" Click="OnChatToolsSettings" ToolTipService.ToolTip="ツール設定" AutomationProperties.Name="ツール設定"><SymbolIcon Symbol="Repair"/></Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Spacing="4">
                    <ToggleButton x:Name="ChatReasoningVisibilityButton" Template="{StaticResource SquircleToggleTemplate}" CornerRadius="8" UseSystemFocusVisuals="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnToggleChatReasoningVisibility" Width="40" Height="40" Padding="0" BorderThickness="0" ToolTipService.ToolTip="推論内容の表示" AutomationProperties.Name="推論内容の表示"><FontIcon Glyph="&#xE890;"/></ToggleButton>
                    <Button x:Name="ChatReasoningButton" Template="{StaticResource SquircleButtonTemplate}" CornerRadius="8" UseSystemFocusVisuals="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnChatReasoningSettings" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="推論レベル" AutomationProperties.Name="推論レベル"><FontIcon Glyph="&#xE82F;"/></Button>
                    <Button x:Name="SendChatButton" Click="OnSendChat" Style="{StaticResource AccentButtonStyle}" Width="40" Height="40" Padding="0" CornerRadius="20" BorderThickness="0" ToolTipService.ToolTip="送信" AutomationProperties.Name="送信"><SymbolIcon Symbol="Send"/></Button>
                    <Button x:Name="StopChatButton" Click="OnStopChat" Width="40" Height="40" Padding="0" CornerRadius="20" Visibility="Collapsed" ToolTipService.ToolTip="停止" AutomationProperties.Name="停止"><SymbolIcon Symbol="Stop"/></Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="LlamaStatusButton" Click="OnToggleServer" Padding="0" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
              <Run x:Name="LlamaStatusPrefix" Text="llama-server: "/><Run x:Name="LlamaStatusState"/><Run x:Name="LlamaStatusDetail" Text="確認中"/>
            </TextBlock>
          </Button>
          <TextBlock Grid.Column="1" Text=" ｜ " FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Name="ConnectionStatusText" Grid.Column="2" TextWrapping="NoWrap" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run x:Name="WebStatusPrefix" Text="Open WebUI: "/><Run x:Name="WebStatusState"/><Run x:Name="WebStatusDetail" Text="確認中"/>
          </TextBlock>
        </Grid>
        <TextBlock x:Name="ChatStatusText" Grid.Column="1" Visibility="Collapsed" TextWrapping="NoWrap" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="直近の推論の入力と生成の合計トークン数 / サーバーの最大コンテキスト数。使用数は応答取得後に更新します。"/>
      </Grid>
    </Border>
  </Grid>
</Window>
